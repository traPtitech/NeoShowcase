{
  "name": "neoshowcase",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "fmt": "biome format src",
    "fmt:apply": "biome format src --write",
    "lint": "biome check src",
    "lint:apply": "biome check src --write",
    "lint:force": "biome check src --write --unsafe",
    "fix": "pnpm fmt:apply && pnpm lint:apply",
    "typecheck": "tsc --noEmit",
    "ci": "biome ci src",
    "analyze": "vite build --mode analyze",
    "test": "vitest"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@iconify-json/material-symbols": "1.2.100",
    "@iconify-json/mdi": "1.2.3",
    "@iconify-json/simple-icons": "1.2.102",
    "@solidjs/diagnostics": "2.0.1",
    "@solidjs/vite-plugin": "3.0.1",
    "@types/node": "26.6.6",
    "@unocss/preset-mini": "66.13.0",
    "jsdom": "31.0.1",
    "rollup-plugin-visualizer": "7.1.3",
    "typescript": "7.0.2",
    "unocss": "66.13.0",
    "unplugin-fonts": "2.1.0",
    "vite": "8.3.8",
    "vite-plugin-compression": "0.5.1",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.17.0",
    "@connectrpc/connect": "2.3.0",
    "@connectrpc/connect-web": "2.3.0",
    "@formisch/solid": "1.3.0",
    "@kobalte/core": "2.0.0-alpha.4",
    "@solidjs/meta": "2.0.0",
    "@solidjs/router": "2.0.0",
    "@solidjs/web": "2.0.1",
    "@unocss/reset": "66.13.0",
    "ansi-to-html": "0.7.2",
    "chart.js": "4.6.1",
    "solid-js": "2.0.1",
    "ts-pattern": "5.9.2",
    "valibot": "1.5.0"
  },
  "packageManager": "pnpm@12.21.0"
}
