{
  "name": "neoshowcase",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "fmt": "biome format src",
    "fmt:apply": "biome format src --write",
    "lint": "biome check src",
    "lint:apply": "biome check src --write",
    "lint:force": "biome check src --write --unsafe",
    "fix": "pnpm fmt:apply && pnpm lint:apply",
    "typecheck": "tsc --noEmit",
    "ci": "biome ci src",
    "analyze": "vite build --mode analyze",
    "test": "vitest"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@iconify-json/material-symbols": "1.2.97",
    "@types/node": "26.6.6",
    "@unocss/preset-mini": "66.12.0",
    "jsdom": "30.1.3",
    "rollup-plugin-visualizer": "7.1.1",
    "typescript": "7.0.2",
    "unocss": "66.12.0",
    "unplugin-fonts": "2.1.0",
    "vite": "8.3.5",
    "vite-plugin-compression": "0.5.1",
    "vite-plugin-solid": "2.11.15",
    "vite-plugin-solid-svg": "0.8.1",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.3.0",
    "@connectrpc/connect-web": "2.3.0",
    "@kobalte/core": "0.13.14",
    "@modular-forms/solid": "0.25.1",
    "@solidjs/meta": "0.29.4",
    "@solidjs/router": "1.0.1",
    "@types/async-lock": "1.4.2",
    "@unocss/reset": "66.12.0",
    "ansi-to-html": "0.7.2",
    "async-lock": "1.4.1",
    "chart.js": "4.6.1",
    "solid-chartjs": "1.3.11",
    "solid-icons": "1.2.0",
    "solid-js": "1.9.18",
    "solid-tippy": "0.2.1",
    "solid-toast": "0.5.0",
    "tippy.js": "6.3.7",
    "ts-pattern": "5.9.2",
    "valibot": "1.5.0",
    "virtua": "0.54.0"
  },
  "packageManager": "pnpm@12.17.0"
}
